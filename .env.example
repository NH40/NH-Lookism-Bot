# Telegram
BOT_TOKEN=your_bot_token_here


POSTGRES_USER=lookism
POSTGRES_PASSWORD=lookism_secret
POSTGRES_DB=lookism_db
DATABASE_URL=postgresql+asyncpg://lookism:lookism_secret@postgres:5432/lookism_db

REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO

#Admins (через запятую, telegram user id)
ADMIN_IDS=
YOOKASSA_PROVIDER_TOKEN=
# Оплата по СБП — прямое API ЮKassa (кабинет: Интеграция → Ключи API). Пусто — кнопки СБП нет.
# Вебхук в кабинете ЮKassa: https://<домен>/api/payments/yookassa (payment.succeeded, payment.canceled)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Адрес БД LBP 1.3 (postgresql://user:pass@host:5432/db) — при старте один раз переносит донат игроков 1.3 в донат-коины.
LBP1_DATABASE_URL=

# --- Mini App ---
MINI_APP_URL=
