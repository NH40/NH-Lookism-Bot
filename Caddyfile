# Внутренний статический сервер SPA (см. Dockerfile.web) — НЕ терминирует HTTPS и не
# знает про домен: публичный домен `lbp.universanimeplanet.ru` обслуживает ОБЩИЙ Caddy
# соседнего проекта Universe Anime Planet (см. `../NH-Universe-Anime-Planet/Caddyfile`),
# который реверс-проксирует сюда через общую внешнюю docker-сеть `edge` (см.
# docker-compose.yml, сервис `web`) — два независимых Caddy не могут одновременно
# слушать 80/443 на одном сервере, поэтому у LBP нет своего порта наружу и своего
# автo-HTTPS, только `:80` внутри сети `edge`.
:80 {
	encode gzip

	root * /srv/web
	# Тот же приём, что у UAP (Caddyfile) — index.html без кэша (иначе после редеплоя
	# Telegram WebView продолжает открывать старую HTML-страницу со старым JS-бандлом),
	# хэшированные assets/* — наоборот, агрессивно и надолго.
	header Cache-Control "no-cache"
	@hashed_assets path /assets/*
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
